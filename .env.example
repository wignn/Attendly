# ==============================================================================
# Attendly Monorepo Root Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API (apps/api)
# ------------------------------------------------------------------------------
PORT=8080
ENV=development
APP_NAME=komas-api

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=komas_db
DB_SSLMODE=disable

# Optional: Full database connection string (takes precedence if provided)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/komas_db?sslmode=disable

# Optional: Test database connection string
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/komas_test_db?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://default:password@localhost:6379

# JWT signing secret. Generate a unique random value (at least 32 bytes) outside development.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Optional one-time bootstrap identity. This email does not grant Super Admin automatically.
SUPER_ADMIN_EMAIL=admin@example.com

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Frontend Web (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
