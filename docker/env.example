# ==============================================================================
# Docker Environment Variables (docker-compose)
# ==============================================================================

# Application
PORT=8080
ENV=development
APP_NAME=komas-api

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=komas_db
DB_SSLMODE=disable

# Full connection string
DATABASE_URL=postgres://postgres:postgres@postgres:5432/komas_db?sslmode=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-development-must-be-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
