# ==============================================================================
# Frontend Web Environment Variables (apps/web)
# ==============================================================================

# Public URL pointing to the Go Backend API (without trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Optional: Google OAuth Client ID for frontend Google Sign-In button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional: Build output mode ("standalone" is enforced automatically in Docker)
# NEXT_OUTPUT=standalone
