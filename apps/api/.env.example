# Application
PORT=8080
ENV=development
APP_NAME=komas-api

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=komas_db
DB_SSLMODE=disable

# Optional: Full database connection string (takes precedence over individual DB_* fields)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/komas_db?sslmode=disable

# Optional: Dedicated database connection string for running integration tests
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/komas_test_db?sslmode=disable

# Redis (Caching, Session Tracking & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: Cloud Redis connection URL (e.g. Upstash, Redis Cloud)
# REDIS_URL=redis://default:password@localhost:6379

# JWT Authentication (HS256). Use a unique random value with at least 32 bytes outside development.
# This is a signing secret; do not reuse the bootstrap email as a secret.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Optional one-time bootstrap identity. This does not grant a role by itself.
SUPER_ADMIN_EMAIL=admin@example.com

# Google OAuth 2.0 (for Google Login verification)
# Get from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret