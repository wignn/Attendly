# Application
PORT=8080
ENV=development
APP_NAME=komas-api

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=komas_db
DB_SSLMODE=disable

# Optional: Full database connection string (takes precedence if provided, e.g. Neon, Supabase)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/komas_db?sslmode=disable

# Redis (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: Cloud Redis connection URL (e.g. Upstash Redis, Vercel KV)
# REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379

# JWT Authentication
# Minimum 32 characters
JWT_SECRET=super-secret-jwt-key-for-development-must-be-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
